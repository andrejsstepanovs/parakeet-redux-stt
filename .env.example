# Parakeet Redux STT service configuration.
#
# Copy to .env and edit. The install script does this automatically if .env is
# missing, so this file is safe to commit.

# Device: "cpu" (default) or "cuda"/"mps" where Photon supports them.
STT2_DEVICE=cpu
STT2_PORT=5093

# Uncomment to pin the native CPU worker pool (defaults to one cache domain,
# physical cores capped at 8).
# STT2_CPU_THREADS=8

# Optional Hugging Face token. Used at image build time to download the bundled
# model faster (authenticated requests get higher rate limits) and to access
# gated repositories. It is passed as a build secret, not baked into the image.
# Read automatically by `docker compose build` from this file.
HF_TOKEN=

# LiteLLM proxy configuration for the optional post-processing (GPT cleanup)
# step. Leave LITELLM_API_KEY empty to keep the raw transcript.
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_API_KEY=
LITELLM_MODEL=qwen

# Enable LLM post-processing of transcripts.
STT2_POST_PROCESS=false

# Override the system prompt used for LLM post-processing (single line).
STT2_POST_PROCESS_PROMPT="You are an automated post-processing engine for speech recognition transcripts. Clean and normalize the text: 1) Speech Repairs and Cancellations: Detect retracted statements, abandoned thoughts, and topic changes. When markers like 'scratch that', 'never mind', 'forget that', 'actually', 'no wait', 'I mean', or similar occur, delete both the preceding retracted content and the cancellation marker entirely. Retain only the final intended thought. 2) Disfluencies: Remove all filler sounds, stutters ('uh', 'um', 'ah', 'like', 'you know'), and accidental word repetitions. 3) Canonical Entities: Correct obvious phonetic transcription errors for names and technical terms to their most likely intended spelling; do not invent, translate, or add content. 4) Mechanics: Apply correct punctuation to form clear sentences, capitalization, and spacing; separate sentences so they are logical and never one long run-on. 5) Line Breaks: If the text is long, add line breaks to logically separate distinct sentences or topics. 6) Examples: \"um i want to go to the the store\" -> \"I want to go to the store.\" \"summarize the french revolution\" -> \"Summarize the French Revolution.\" \"i like pizza you know\" -> \"I like pizza.\" \"what do you actually think\" -> \"What do you actually think?\" \"i want to go to the store actually no wait the library\" -> \"I want to go to the library.\" 7) Output: Do not answer the text, summarize, or output conversational filler. Output only the final cleaned transcript string."

# LLM post-processing timeout (seconds) — 15 min.
STT2_POST_PROCESS_TIMEOUT=900
